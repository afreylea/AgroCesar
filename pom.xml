<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!-- ── Parent: Spring Boot 4.0.x para Java 25 ────── -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.0</version>  
    <relativePath/>
  </parent>

  <!-- ── Coordenadas del proyecto ───────────────────── -->
  <groupId>com.agrocesar</groupId>
  <artifactId>agrocesar</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>agrocesar</name>
  <description>
    Sistema de Monitoreo de Cultivos y Alertas Climáticas
    — Departamento del Cesar
  </description>

  <!-- ── Propiedades globales ────────────────────────── -->
  <properties>
    <!-- Java 25 LTS -->
    <java.version>25</java.version>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <maven.compiler.enablePreview>false</maven.compiler.enablePreview>
    <maven.compiler.release>25</maven.compiler.release>

    <!-- JDBI: versión centralizada para los 3 artefactos -->
    <jdbi.version>3.47.0</jdbi.version>
  </properties>

  <!-- ── BOM de JDBI ────────────────────────────────── -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.jdbi</groupId>
        <artifactId>jdbi3-bom</artifactId>
        <version>${jdbi.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- ── Dependencias ────────────────────────────────── -->
  <dependencies>


    <!-- == SPRING WEB + TOMCAT EMBEBIDO == -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- == THYMELEAF == -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>

    <!-- sec:authorize y #authentication en vistas Thymeleaf -->
    <dependency>
     <groupId>org.thymeleaf.extras</groupId>
    <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>

    <!-- == SPRING SECURITY == -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

<!-- == WEBFLUX / WEBCLIENT (solo como cliente HTTP) == -->
<dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-webflux</artifactId>
    <exclusions>
        <exclusion>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-reactor-netty</artifactId>
        </exclusion>
    </exclusions>
</dependency>

    <!-- == SPRING JDBC (DataSource para JDBI) == -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>


    <!-- == JDBI 3 == -->
    <dependency>
      <groupId>org.jdbi</groupId>
      <artifactId>jdbi3-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.jdbi</groupId>
      <artifactId>jdbi3-sqlobject</artifactId>
    </dependency>

    <!-- Integración JDBI con Spring Framework 7        -->
    <!-- El artefacto mantiene nombre -spring5 pero     -->
    <!-- soporta Spring 6 y 7 sin cambios en la API.   -->
    <dependency>
      <groupId>org.jdbi</groupId>
      <artifactId>jdbi3-spring5</artifactId>
    </dependency>

    <!-- == ORACLE JDBC (runtime) == -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- == TESTING == -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>


  <!-- Jakarta EE API — requerido por Spring Boot 4.0 -->
<dependency>
    <groupId>jakarta.annotation</groupId>
    <artifactId>jakarta.annotation-api</artifactId>
</dependency>

    <!-- Lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

      <!-- == JAVA MAIL SENDER == -->
      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-mail</artifactId>
      </dependency>
    
      <!--Dependencias de la API de Twilio-->
  <dependency>
    <groupId>com.twilio.sdk</groupId>
    <artifactId>twilio</artifactId>
    <version>10.1.5</version>
</dependency>

  </dependencies>



  <!-- ── Plugin de build ─────────────────────────────── -->
  <build>
    <plugins>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <jvmArguments>-Djava.awt.headless=false</jvmArguments>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>25</release>
        </configuration>
      </plugin>

    </plugins>
  </build>

</project>